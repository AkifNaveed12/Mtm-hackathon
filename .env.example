# HackPlan AI - Environment Configuration Example
# Copy this file to .env and provide your actual API keys

# LLM Providers (Groq recommended for high-speed small-model inference under 2-min limit)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Legacy placeholders retained; the implemented planner currently uses Groq.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# auto: one bounded provider attempt with explicit offline fallback.
# provider: actual model required. offline: deterministic parser, no model calls.
PLANNER_MODE=auto
# SQLite defaults are ignored files under data/; these paths are optional.
# PLANNER_DB_PATH=data/planner.sqlite3
# WHATSAPP_DB_PATH=data/whatsapp.sqlite3

# Optional local organizer API protection. Enter the same key in the dashboard.
# Never use NEXT_PUBLIC_ for this key.
ORGANIZER_API_KEY=

# Existing custom WhatsApp REST service, server-side only.
WHATSAPP_API_URL=https://your-existing-whatsapp-service.example
WHATSAPP_API_KEY=your_whatsapp_api_key_here
# Keep false until an organizer explicitly authorizes live delivery.
WHATSAPP_ALLOW_LIVE_SEND=false
# For a public relay signing the exact webhook body using HMAC-SHA256.
WHATSAPP_WEBHOOK_SECRET=
